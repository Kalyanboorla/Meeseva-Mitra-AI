# MeeSeva Mitra AI — Backend Environment Variables Template
# Copy this file to .env (or backend/.env) and fill in real values.
# NEVER commit .env to git.

# ── Flask Configuration ──────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key-in-production
PORT=5000

# ── Database Configuration ───────────────────────────────────
# If MySQL is not running, the application automatically falls back
# to the local SQLite database at database/meeseva_mitra.db with zero configuration.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meeseva_mitra
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ── AI Provider (Google Gemini) ──────────────────────────────
# Optional: If omitted, the application uses grounded deterministic database fallback.
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ── CORS Configuration ───────────────────────────────────────
# Comma-separated list of allowed frontend client origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate Limiting ─────────────────────────────────────────────
# Maximum requests per minute per client IP for AI & rejection endpoints
AI_RATE_LIMIT=30
